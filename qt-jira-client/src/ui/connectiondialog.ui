     <item row="2" column="0">
      <widget class="QLabel" name="usernameLabel">
       <property name="text">
        <string>User:</string>
       </property>
      </widget>
     </item>
     <item row="2" column="1">
      <widget class="QLineEdit" name="username">
       <property name="placeholderText">
        <string>user name, or you@example.com on Cloud</string>
       </property>
      </widget>
     </item>
     <item row="3" column="0">
      <widget class="QLabel" name="tokenLabel">
       <property name="text">
        <string>API token:</string>
       </property>
      </widget>
     </item>
     <item row="3" column="1">
      <widget class="QLineEdit" name="token">
       <property name="echoMode">
        <enum>QLineEdit::Password</enum>
       </property>
       <property name="placeholderText">
        <string>API token</string>
       </property>
      </widget>
     </item>
     <item row="4" column="1">
      <widget class="QCheckBox" name="rememberToken">
       <property name="toolTip">
        <string>Stored in this application's settings file as plain text. Leave it off and set JIRA_API_TOKEN in the environment instead if the machine is shared.</string>
       </property>
       <property name="text">
        <string>Remember the token on this computer</string>
       </property>
      </widget>
     </item>
     <item row="5" column="0">
      <widget class="QLabel" name="caCertificateLabel">
       <property name="text">
        <string>CA certificate:</string>
       </property>
      </widget>
     </item>
     <item row="5" column="1">
      <layout class="QHBoxLayout" name="certificateRow">
       <item>
        <widget class="QLineEdit" name="caCertificate">
         <property name="placeholderText">
