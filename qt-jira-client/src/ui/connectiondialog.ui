       <item>
        <widget class="QPushButton" name="browse">
         <property name="text">
          <string>Browse…</string>
         </property>
        </widget>
       </item>
      </layout>
     </item>
     <item row="6" column="1">
      <widget class="QCheckBox" name="allowInvalidCertificates">
       <property name="toolTip">
        <string>Disables certificate verification entirely. Prefer pointing the field above at your certificate authority's PEM file.</string>
       </property>
       <property name="text">
        <string>Accept any certificate (insecure)</string>
