    <height>380</height>
   </rect>
  </property>
  <property name="windowTitle">
   <string>Connect to Jira</string>
  </property>
  <property name="modal">
   <bool>true</bool>
  </property>
  <layout class="QVBoxLayout" name="verticalLayout">
   <item>
    <layout class="QFormLayout" name="formLayout">
     <item row="0" column="0">
      <widget class="QLabel" name="baseUrlLabel">
       <property name="text">
        <string>Server URL:</string>
       </property>
      </widget>
     </item>
     <item row="0" column="1">
      <widget class="QLineEdit" name="baseUrl">
       <property name="toolTip">
        <string>The address you open Jira with. If Jira is served under a path, include it: https://intranet.example.com/jira</string>
       </property>
       <property name="placeholderText">
        <string notr="true">https://jira.example.com</string>
       </property>
      </widget>
     </item>
     <item row="1" column="0">
      <widget class="QLabel" name="authModeLabel">
       <property name="text">
        <string>Jira type:</string>
       </property>
