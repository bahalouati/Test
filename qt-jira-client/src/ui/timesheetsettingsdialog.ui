     </item>
     <item row="2" column="1">
      <widget class="QLineEdit" name="mergeRequestMarker">
       <property name="toolTip">
        <string>A remote link counts as the merge request when its URL contains this. Use /pull/ for GitHub. Empty skips the lookup entirely, which makes loading a month faster.</string>
       </property>
       <property name="placeholderText">
        <string notr="true">/merge_requests/</string>
